// Place your key bindings in this file to override the defaults
[
  {
    "command": "-editor.action.clipboardCutAction",
    "key": "ctrl+delete"
  },
  {
    "args": {
      "by": "halfLine",
      "to": "up",
      "value": 5
    },
    "command": "cursorMove",
    "key": "ctrl+win+up",
    "when": "editorTextFocus"
  },
  {
    "args": {
      "by": "halfLine",
      "to": "down",
      "value": 5
    },
    "command": "cursorMove",
    "key": "ctrl+win+down",
    "when": "editorTextFocus"
  },
  {
    "command": "-workbench.action.terminal.openNativeConsole",
    "key": "ctrl+shift+c",
    "when": "!terminalFocus"
  },
  {
    "command": "copyRelativeFilePath",
    "key": "ctrl+shift+c",
    "when": "!editorFocus"
  },
  {
    "command": "-copyRelativeFilePath",
    "key": "ctrl+k ctrl+shift+c",
    "when": "!editorFocus"
  },
  {
    "command": "copyRelativeFilePath",
    "key": "ctrl+shift+c",
    "when": "editorFocus"
  },
  {
    "command": "-copyRelativeFilePath",
    "key": "ctrl+k ctrl+shift+c",
    "when": "editorFocus"
  }
]